---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const tagCount = new Map<string, number>();
for (const post of allPosts) {
  const tags = post.data.tags || [];
  for (const tag of tags) {
    tagCount.set(tag, (tagCount.get(tag) || 0) + 1);
  }
}

const tags = Array.from(tagCount.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 30);
---

<div class="card-base p-3 border border-black/10 dark:border-white/10">
  <div class="mb-2.5 flex items-center justify-between">
    <span class="text-sm font-semibold text-black/80 dark:text-white/80">标签</span>
    <a href="/tags/" class="text-xs text-black/40 dark:text-white/40 hover:text-[var(--primary)] transition-colors no-underline">更多 →</a>
  </div>
  <div class="tag-items">
    {tags.map((tag) => (
      <a href={`/tags/${tag.name}/`} class="tag-item">
        {tag.name}
        <span class="tag-count">{tag.count}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .tag-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 12px;
    line-height: 1.6;
    color: #374151;
    background: #e5e7eb;
    text-decoration: none;
    transition: all 0.2s;
  }

  html.dark .tag-item {
    color: #d1d5db;
    background: rgba(55, 65, 81, 0.7);
  }

  .tag-item:hover {
    color: #ffffff;
    background: #00a2e8;
  }

  .tag-count {
    font-size: 10px;
    opacity: 0.55;
  }
</style>
