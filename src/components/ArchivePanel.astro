---
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	keyword?: string;
}

let posts = await getSortedPosts();

// 按年份和月份分组
interface MonthGroup {
	month: number;
	posts: typeof posts;
}

interface YearGroup {
	year: number;
	months: MonthGroup[];
}

const groups: YearGroup[] = (() => {
	const yearGroups: { [year: number]: { [month: number]: typeof posts } } = {};

	posts.forEach((post) => {
		const year = post.data.published.getFullYear();
		const month = post.data.published.getMonth() + 1;

		if (!yearGroups[year]) {
			yearGroups[year] = {};
		}
		if (!yearGroups[year][month]) {
			yearGroups[year][month] = [];
		}
		yearGroups[year][month].push(post);
	});

	const result: YearGroup[] = Object.keys(yearGroups)
		.map((year) => {
			const yearNum = Number.parseInt(year);
			const months: MonthGroup[] = Object.keys(yearGroups[yearNum])
				.map((month) => ({
					month: Number.parseInt(month),
					posts: yearGroups[yearNum][Number.parseInt(month)],
				}))
				.sort((a, b) => b.month - a.month);

			return { year: yearNum, months };
		})
		.sort((a, b) => b.year - a.year);

	return result;
})();

function formatDate(date: Date) {
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	const day = date.getDate().toString().padStart(2, "0");
	return `${month}-${day}`;
}

const monthNames = [
	"",
	"一月",
	"二月",
	"三月",
	"四月",
	"五月",
	"六月",
	"七月",
	"八月",
	"九月",
	"十月",
	"十一月",
	"十二月",
];
---

<div class="card-base px-8 py-6">
    {groups.map(yearGroup => (
        <div class="year-group">
            {/* 年份 */}
            <div class="flex flex-row w-full items-center h-[3.75rem]">
                <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">{yearGroup.year}</div>
                <div class="w-[15%] md:w-[10%]">
                    <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
                </div>
                <div class="w-[70%] md:w-[80%] transition text-left text-50">
                    {yearGroup.months.reduce((sum, m) => sum + m.posts.length, 0)} 篇
                </div>
            </div>
            
            {/* 月份 */}
            {yearGroup.months.map(monthGroup => (
                <div class="month-group">
                    <div class="flex flex-row w-full items-center h-8">
                        <div class="w-[15%] md:w-[10%] transition text-sm font-bold text-right text-75">
                            {monthNames[monthGroup.month]}
                        </div>
                        <div class="w-[15%] md:w-[10%]">
                            <div class="h-2 w-2 bg-[var(--primary)] rounded-full mx-auto"></div>
                        </div>
                        <div class="w-[70%] md:w-[80%]"></div>
                    </div>
                    
                    {/* 文章列表 */}
                    {monthGroup.posts.map(post => (
                        <a href={getPostUrlBySlug(post.id)}
                           aria-label={post.data.title}
                           class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
                        >
                            <div class="flex flex-row justify-start items-center h-full">
                                <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                                    {formatDate(post.data.published)}
                                </div>
                                <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                                    <div class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5
                                    bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)]
                                    outline outline-4 z-50
                                    outline-[var(--card-bg)]
                                    group-hover:outline-[var(--btn-plain-bg-hover)]
                                    group-active:outline-[var(--btn-plain-bg-active)]"
                                    ></div>
                                </div>
                                <div class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold
                                    group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)]
                                    text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
                                >
                                    {post.data.title}
                                </div>
                                <div class="hidden md:block md:w-[15%] text-left text-sm transition
                                    whitespace-nowrap overflow-ellipsis overflow-hidden text-30"
                                ></div>
                            </div>
                        </a>
                    ))}
                </div>
            ))}
        </div>
    ))}
</div>