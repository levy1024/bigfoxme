---
import { siteConfig } from "@/config";
import type { Friend } from "@/types/data";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PageHeader from "@components/widget/PageHeader.astro";
import { Icon } from "astro-icon/components";
import categoryOrderConfig from "@/data/nav/_category-order.json";

const navModules = import.meta.glob<Friend>("@/data/nav/*.json", {
  eager: true,
  import: "default",
});
const friends = Object.entries(navModules)
  .filter(([path]) => !path.includes("_category-order"))
  .map(([, data]) => data);

// 从 JSON 的 subcategory 字段动态构建二级分类
interface SubCategory {
  name: string;
  friends: Friend[];
}

interface CategoryData {
  name: string;
  rootFriends: Friend[];
  subCategories: SubCategory[];
  totalCount: number;
}

const categoryDataMap = new Map<string, CategoryData>();

for (const friend of friends) {
  const cat = friend.category || "未分类";
  if (!categoryDataMap.has(cat)) {
    categoryDataMap.set(cat, { name: cat, rootFriends: [], subCategories: [], totalCount: 0 });
  }
  const data = categoryDataMap.get(cat)!;
  data.totalCount++;

  const sub = friend.subcategory;
  if (sub) {
    let subData = data.subCategories.find(s => s.name === sub);
    if (!subData) {
      subData = { name: sub, friends: [] };
      data.subCategories.push(subData);
    }
    subData.friends.push(friend);
  } else {
    data.rootFriends.push(friend);
  }
}

const catOrder = categoryOrderConfig.order.map((o) => o.category);

const sortedCategories = Array.from(categoryDataMap.entries())
  .sort((a, b) => {
    const ia = catOrder.indexOf(a[0]);
    const ib = catOrder.indexOf(b[0]);
    if (ia === -1 && ib === -1) return a[0].localeCompare(b[0], "zh-CN");
    if (ia === -1) return 1;
    if (ib === -1) return -1;
    return ia - ib;
  })
  .map(([_, data]) => {
    const subOrder =
      categoryOrderConfig.order.find((o) => o.category === data.name)
        ?.subcategories ?? [];
    data.subCategories.sort((a, b) => {
      const ia = subOrder.indexOf(a.name);
      const ib = subOrder.indexOf(b.name);
      if (ia === -1 && ib === -1)
        return a.name.localeCompare(b.name, "zh-CN");
      if (ia === -1) return 1;
      if (ib === -1) return -1;
      return ia - ib;
    });
    return data;
  });

function catId(name: string): string {
  return "cat-" + name.replace(/\s+/g, "-");
}
function subId(cat: string, sub: string): string {
  return catId(cat) + "-" + sub.replace(/\s+/g, "-");
}
---

<MainGridLayout title="导航">
  <PageHeader
    icon="material-symbols:explore-outline"
    title="导航"
    description="常用工具与资源导航"
  />

  <div class="nav-content-wrapper">
    <!-- 左侧分类导航 -->
    <nav class="nav-left-panel">
      <div class="nav-left-panel-inner">
        <div class="nav-left-panel-title">分类</div>
        <ul class="category-nav-list">
          {sortedCategories.map((cat) => (
            <li>
              <a href={`#${catId(cat.name)}`} class="category-nav-link">
                <span class="category-nav-name">{cat.name}</span>
                <span class="category-nav-count">{cat.totalCount}</span>
              </a>
              {cat.subCategories.length > 0 && (
                <ul class="category-sub-list">
                  {cat.subCategories.map((sub) => (
                    <li>
                      <a href={`#${subId(cat.name, sub.name)}`} class="category-sub-link">
                        <span class="category-sub-name">{sub.name}</span>
                        <span class="category-sub-count">{sub.friends.length}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="card-base p-6 md:p-8 nav-content-card">
        <div class="space-y-8">
          {sortedCategories.map((cat) => (
            <div id={catId(cat.name)} class="category-section">
              <div class="category-header">
                <span class="font-bold text-base" style="color: var(--primary)">{cat.name}</span>
              </div>

              {cat.subCategories.length > 0 && (
                <div class="subcategory-tabs">
                  <button class="sub-tab active" data-cat={catId(cat.name)} data-sub="">
                    全部 ({cat.totalCount})
                  </button>
                  {cat.subCategories.map((sub) => (
                    <button class="sub-tab" data-cat={catId(cat.name)} data-sub={subId(cat.name, sub.name)}>
                      {sub.name} ({sub.friends.length})
                    </button>
                  ))}
                </div>
              )}

              <!-- 全部卡片（默认显示） -->
              <div class="friend-grid" id={`grid-${catId(cat.name)}`}>
                {[...cat.rootFriends, ...cat.subCategories.flatMap(s => s.friends)].map((friend) => (
                  <a href={friend.url} target="_blank" class="friend-card">
                    <div class="friend-card-inner">
                      <div class="friend-card-icon">
                        <img src={friend.avatar} loading="lazy" alt={friend.name} />
                      </div>
                      <div class="friend-card-content">
                        <div class="friend-card-name">{friend.name}</div>
                        <div class="friend-card-desc">{friend.description}</div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>

              <!-- 二级分类卡片（按 tab 分组，默认隐藏） -->
              {cat.subCategories.map((sub) => (
                <div class="friend-grid hidden" id={`grid-${subId(cat.name, sub.name)}`}>
                  {sub.friends.map((friend) => (
                    <a href={friend.url} target="_blank" class="friend-card">
                      <div class="friend-card-inner">
                        <div class="friend-card-icon">
                          <img src={friend.avatar} loading="lazy" alt={friend.name} />
                        </div>
                        <div class="friend-card-content">
                          <div class="friend-card-name">{friend.name}</div>
                          <div class="friend-card-desc">{friend.description}</div>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              ))}

              {/* 无二级分类时直接显示卡片 */}
              {cat.subCategories.length === 0 && (
                <div class="friend-grid" id={`grid-${catId(cat.name)}`}>
                  {cat.rootFriends.map((friend) => (
                    <a href={friend.url} target="_blank" class="friend-card">
                      <div class="friend-card-inner">
                        <div class="friend-card-icon">
                          <img src={friend.avatar} loading="lazy" alt={friend.name} />
                        </div>
                        <div class="friend-card-content">
                          <div class="friend-card-name">{friend.name}</div>
                          <div class="friend-card-desc">{friend.description}</div>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>

<script>
  function initTabs() {
    document.querySelectorAll('.subcategory-tabs').forEach((tabsContainer) => {
      tabsContainer.querySelectorAll('.sub-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const cat = tab.getAttribute('data-cat');
          const sub = tab.getAttribute('data-sub');

          // 更新 tab 激活状态
          tabsContainer.querySelectorAll('.sub-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          // 隐藏所有同分类的 grid
          document.querySelectorAll(`.friend-grid[id^="grid-${cat}"]`).forEach(g => g.classList.add('hidden'));

          // 显示目标 grid
          const targetId = sub ? `grid-${sub}` : `grid-${cat}`;
          const target = document.getElementById(targetId);
          if (target) target.classList.remove('hidden');
        });
      });
    });
  }

  // Astro 页面加载后初始化
  document.addEventListener('astro:page-load', initTabs);
  // 首次加载也初始化
  initTabs();
</script>

<style>
  /* 内容区 wrapper — 相对定位，让分类面板以它为基准 */
  .nav-content-wrapper {
    position: relative;
  }

  /* 左侧分类面板 — 紧贴 card-base 左侧 */
  .nav-left-panel {
    display: none;
    position: absolute;
    top: 0;
    right: calc(100% + 1rem);
    width: max-content;
    max-width: 12rem;
  }

  @media (min-width: 1024px) {
    .nav-left-panel {
      display: block;
    }
  }

  .nav-left-panel-inner {
    position: sticky;
    top: 1.25rem;
    width: max-content;
    min-width: 7rem;
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
    background: var(--card-bg);
    border-radius: var(--radius-large);
    border: 1px solid rgb(0 0 0 / 0.08);
    padding: 0.75rem 1rem;
  }

  .dark .nav-left-panel-inner {
    border-color: rgb(255 255 255 / 0.08);
  }

  .nav-content-card {
    width: 100%;
  }

  .nav-left-panel-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: oklch(0.55 0.01 268);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    padding: 0 0.25rem;
  }

  .dark .nav-left-panel-title {
    color: oklch(0.55 0.01 268);
  }

  .category-nav-inner {
    padding: 1rem;
  }

  .category-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .category-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    text-decoration: none;
    color: rgb(80, 80, 80);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.15s;
  }

  .category-nav-link:hover {
    background: rgb(0 0 0 / 0.06);
    color: var(--primary);
  }

  .dark .category-nav-link {
    color: rgb(180, 180, 180);
  }

  .dark .category-nav-link:hover {
    background: rgb(255 255 255 / 0.06);
    color: var(--primary);
  }

  .category-nav-count {
    font-size: 0.7rem;
    color: rgb(150, 150, 150);
    background: rgb(0 0 0 / 0.05);
    padding: 1px 6px;
    border-radius: 999px;
    min-width: 1.25rem;
    text-align: center;
  }

  .dark .category-nav-count {
    color: rgb(140, 140, 140);
    background: rgb(255 255 255 / 0.06);
  }

  /* 二级分类链接 */
  .category-sub-list {
    list-style: none;
    padding: 0 0 0 1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .category-sub-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    text-decoration: none;
    color: rgb(100, 100, 100);
    font-size: 0.8rem;
    transition: all 0.15s;
  }

  .category-sub-link:hover {
    background: rgb(0 0 0 / 0.04);
    color: var(--primary);
  }

  .dark .category-sub-link {
    color: rgb(160, 160, 160);
  }

  .dark .category-sub-link:hover {
    background: rgb(255 255 255 / 0.04);
    color: var(--primary);
  }

  .category-sub-count {
    font-size: 0.65rem;
    color: rgb(170, 170, 170);
  }

  .dark .category-sub-count {
    color: rgb(130, 130, 130);
  }


  html {
    scroll-behavior: smooth;
  }

  .category-section {
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
  }

  .category-header {
    margin-bottom: 0.75rem;
    padding-left: 0.25rem;
  }

  /* 二级分类 Tab */
  .subcategory-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .sub-tab {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(0 0 0 / 0.1);
    background: transparent;
    color: rgb(80, 80, 80);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .sub-tab:hover {
    background: rgb(0 0 0 / 0.04);
    border-color: rgb(0 0 0 / 0.15);
  }

  .sub-tab.active {
    background: #00a2e8;
    color: white;
    border-color: #00a2e8;
  }

  .dark .sub-tab {
    border-color: rgb(255 255 255 / 0.1);
    color: rgb(180, 180, 180);
  }

  .dark .sub-tab:hover {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.15);
  }

  .dark .sub-tab.active {
    background: #00a2e8;
    color: white;
    border-color: #00a2e8;
  }

  /* 链接卡片 */
  .friend-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .friend-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .friend-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .friend-grid.hidden {
    display: none;
  }

  .friend-card {
    display: block;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .friend-card-inner {
    background: rgb(255, 255, 255);
    border-radius: 12px;
    padding: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 100%;
  }

  .dark .friend-card-inner {
    background: rgb(45, 45, 45);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .friend-card:hover .friend-card-inner {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .dark .friend-card:hover .friend-card-inner {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .friend-card-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: rgb(245, 245, 245);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dark .friend-card-icon {
    background: rgb(55, 55, 55);
  }

  .friend-card-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .friend-card-content {
    flex: 1;
    min-width: 0;
  }

  .friend-card-name {
    font-size: 14px;
    font-weight: 600;
    color: rgb(30, 30, 30);
    margin-bottom: 2px;
    line-height: 1.3;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dark .friend-card-name {
    color: rgb(230, 230, 230);
  }

  .friend-card-desc {
    font-size: 12px;
    color: rgb(140, 140, 140);
    line-height: 1.4;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dark .friend-card-desc {
    color: rgb(160, 160, 160);
  }

  .friend-card:hover .friend-card-name {
    color: var(--primary);
  }

  .friend-card:hover .friend-card-icon {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }

  /* 移动端 */
  @media (max-width: 1023px) {

    .category-nav-inner {
      padding: 0 0 0.5rem 0;
    }

    .category-nav-list {
      flex-direction: row;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 4px;
      -webkit-overflow-scrolling: touch;
    }

    .category-nav-list::-webkit-scrollbar {
      display: none;
    }

    .category-nav-list > li {
      flex-shrink: 0;
    }

    .category-nav-link {
      white-space: nowrap;
      font-size: 0.8rem;
      padding: 0.3rem 0.6rem;
      background: rgb(0 0 0 / 0.04);
      border-radius: 999px;
    }

    .dark .category-nav-link {
      background: rgb(255 255 255 / 0.05);
    }

    .category-nav-link:hover {
      background: var(--primary);
      color: white;
    }

    .category-nav-count {
      display: none;
    }

    .category-sub-list {
      display: none;
    }
  }
</style>
